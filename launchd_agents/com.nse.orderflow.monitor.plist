<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nse.orderflow.monitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/sunilkumar/myProjects/ShortIndicator/venv/bin/python3</string>
        <string>/Users/sunilkumar/myProjects/ShortIndicator/order_flow_monitor.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/sunilkumar/myProjects/ShortIndicator</string>

    <!-- Start at 9:14 AM Mon–Fri (1 min before market open for WS connection setup) -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>14</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>14</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>14</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>14</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>14</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/sunilkumar/myProjects/ShortIndicator/logs/order-flow-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sunilkumar/myProjects/ShortIndicator/logs/order-flow-stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
