<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Volume Profile Analyzer - Daily Automation -->
    <!-- Runs ONCE at 3:25 PM on weekdays (near market close) -->

    <key>Label</key>
    <string>com.shortindicator.volumeprofile</string>

    <!-- Command to run -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/sunilkumar/myProjects/ShortIndicator/start_volume_profile.sh</string>
    </array>

    <!-- Working directory -->
    <key>WorkingDirectory</key>
    <string>/Users/sunilkumar/myProjects/ShortIndicator</string>

    <!-- Run at 3:25 PM on weekdays (Mon-Fri) -->
    <key>StartCalendarInterval</key>
    <array>
        <!-- Monday -->
        <dict>
            <key>Hour</key><integer>15</integer>
            <key>Minute</key><integer>25</integer>
            <key>Weekday</key><integer>1</integer>
        </dict>
        <!-- Tuesday -->
        <dict>
            <key>Hour</key><integer>15</integer>
            <key>Minute</key><integer>25</integer>
            <key>Weekday</key><integer>2</integer>
        </dict>
        <!-- Wednesday -->
        <dict>
            <key>Hour</key><integer>15</integer>
            <key>Minute</key><integer>25</integer>
            <key>Weekday</key><integer>3</integer>
        </dict>
        <!-- Thursday -->
        <dict>
            <key>Hour</key><integer>15</integer>
            <key>Minute</key><integer>25</integer>
            <key>Weekday</key><integer>4</integer>
        </dict>
        <!-- Friday -->
        <dict>
            <key>Hour</key><integer>15</integer>
            <key>Minute</key><integer>25</integer>
            <key>Weekday</key><integer>5</integer>
        </dict>
    </array>

    <!-- Do NOT restart on exit -->
    <key>KeepAlive</key>
    <false/>

    <!-- Do NOT run on load (only at scheduled times) -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Standard output log -->
    <key>StandardOutPath</key>
    <string>/Users/sunilkumar/myProjects/ShortIndicator/logs/volumeprofile-stdout.log</string>

    <!-- Standard error log -->
    <key>StandardErrorPath</key>
    <string>/Users/sunilkumar/myProjects/ShortIndicator/logs/volumeprofile-stderr.log</string>

    <!-- Environment variables -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Process type (background) -->
    <key>ProcessType</key>
    <string>Background</string>

    <!-- Nice value (lower priority) -->
    <key>Nice</key>
    <integer>1</integer>

</dict>
</plist>
