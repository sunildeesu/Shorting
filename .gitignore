# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv

# Environment variables
.env

# Data and cache files
data/*.json
data/*.pkl
data/eod_cache/
data/eod_reports/
!data/.gitkeep
logs/*.log
!logs/.gitkeep

# SQLite temporary files (WAL mode)
*.db-wal
*.db-shm

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# LaunchDaemon and automation configs (contain local paths).
# Still ignored everywhere so plists written by setup_*.sh into the repo root, or
# dropped in by tooling, do not get committed by accident. The single exception is
# launchd_agents/, which is the versioned copy of the production schedule
# (see launchd_agents/README.md).
*.plist
!launchd_agents/*.plist

# Shell scripts that may contain sensitive commands
refresh_token_quick.sh
data/alerts/*.xlsx
data/alerts/*backup*.xlsx
data/backtest_results/
data/test_cache/
data/unified_cache/
data/eod_reports/
data/friday_reminder_tracking.json

# Sector analysis runtime data
data/sector_eod_reports/
data/sector_snapshots/
data/friday_reminder_tracking.json

# Historical price data cache (auto-generated)
data/historical_cache/

# OI (Open Interest) analysis cache
data/oi_cache/

# Screener results
data/screener_results/

# Runtime process files
data/caffeinate.pid
*.pid

# Credentials and sensitive files
credentials/
*.json.secret

# Database files (too large for git)
*.db

# Local market data — not needed on GitHub
data/

# Runtime logs — keep the dir (via .gitkeep) but not the log files
logs/
!logs/.gitkeep
